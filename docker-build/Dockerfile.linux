ARG NODE_VERSION=24
ARG BUILDER_PLATFORM=linux/amd64
FROM --platform=${BUILDER_PLATFORM} node:${NODE_VERSION}-bookworm-slim AS node24

FROM --platform=${BUILDER_PLATFORM} electronuserland/builder:latest

ARG TARGETARCH
ARG PNPM_VERSION=10
ARG YARN_VERSION=1.22.22

RUN test "${TARGETARCH}" = "amd64" || \
    { echo "electronuserland/builder requires --platform linux/amd64" >&2; exit 1; }

# Keep Node 24 separate from the toolchain bundled with the builder image.
COPY --from=node24 /usr/local/ /opt/node24/

ENV PATH="/opt/node24/bin:${PATH}" \
    NPM_CONFIG_PREFIX=/opt/node24

RUN rm -f /opt/node24/bin/yarn /opt/node24/bin/yarnpkg \
    && npm install --global "pnpm@${PNPM_VERSION}" "yarn@${YARN_VERSION}" \
    && npm cache clean --force \
    && node -e "if (process.versions.node.split('.')[0] !== '24' || process.arch !== 'x64') process.exit(1)" \
    && node --version \
    && npm --version \
    && pnpm --version \
    && yarn --version

LABEL org.opencontainers.image.title="Electron Builder - Linux amd64 - Node 24"

WORKDIR /project
CMD ["/bin/bash"]
