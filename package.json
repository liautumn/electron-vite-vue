{
  "name": "autumn-electron",
  "version": "1.0.0",
  "main": "dist-electron/main/index.js",
  "description": "Really simple Electron + Vue + Vite boilerplate.",
  "author": "autumn <16638808906@163.com>",
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "rollup",
    "vite",
    "vue3",
    "vue"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "build:test": "vite build --mode test && electron-builder",
    "rebuild:native": "electron-builder install-app-deps",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.15.0",
    "electron": "^41.10.7",
    "electron-builder": "^26.8.1",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass-embedded": "^1.93.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vite-plugin-electron": "^0.29.1",
    "vue": "^3.5.32",
    "vue-i18n": "^11.3.2",
    "vue-router": "^5.0.4",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "better-sqlite3": "^12.9.0",
    "echarts": "^6.0.0",
    "electron-log": "^5.4.3",
    "element-plus": "^2.14.5",
    "mqtt": "^5.15.1",
    "onnxruntime-node": "^1.29.0",
    "serialport": "^13.0.0",
    "sharp": "^0.35.3",
    "sherpa-onnx-node": "^1.13.4"
  },
  "allowScripts": {
    "electron@41.10.7": true,
    "onnxruntime-node@1.29.0": true
  }
}
